{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/task-verification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "phase", "startedAt", "finishedAt", "status", "steps", "planSteps", "acceptance", "errorSummary", "firstBlockingErrorId", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string" },
    "phase": { "enum": ["before", "after"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed", "partial"] },
    "steps": { "type": "array", "items": { "type": "object" } },
    "planSteps": { "type": "array", "items": { "type": "object" } },
    "acceptance": { "type": "object" },
    "errorSummary": { "type": "object" },
    "firstBlockingErrorId": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
