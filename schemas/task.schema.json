{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/task.schema.json",
  "title": "Framework Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "framework", "framework_commit", "level", "status", "objective", "non_goals", "prerequisites", "context", "allowed_paths", "forbidden_paths", "acceptance_criteria", "commands", "expected_result", "actual_result", "failure_category", "knowledge_updates"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "framework_commit": { "type": ["string", "null"] },
    "level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "status": { "enum": ["draft", "ready", "in-progress", "passed", "failed", "blocked"] },
    "objective": { "type": "string" },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_cards", "source_files", "documents", "notes"],
      "properties": {
        "knowledge_cards": { "type": "array", "items": { "type": "string" } },
        "source_files": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "commands": { "type": "array", "items": { "type": "string" } },
    "expected_result": { "type": "string" },
    "actual_result": { "type": ["string", "null"] },
    "failure_category": {
      "type": ["string", "null"],
      "enum": [null, "framework-bug", "documentation-gap", "documentation-error", "api-design", "developer-experience", "compatibility", "performance", "knowledge-error", "prompt-error", "test-gap", "example-error"]
    },
    "knowledge_updates": { "type": "array", "items": { "type": "string" } }
  }
}
