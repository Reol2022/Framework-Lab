{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog Snapshot",
  "type": "object",
  "required": ["schemaVersion", "frameworkId", "snapshotId", "sourceCommit", "dirty", "dirtyFingerprint", "generatedAt", "scannerVersion", "rootHash", "counts", "files", "catalogFiles", "warnings", "exclusions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "frameworkId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "snapshotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "dirty": { "type": "boolean" },
    "dirtyFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scannerVersion": { "const": "0.1.5" },
    "rootHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "files": { "type": "array", "items": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$" } }
  }
}
