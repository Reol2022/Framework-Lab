{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/documentation-coverage.schema.json",
  "type": "object",
  "required": ["schemaVersion", "frameworkId", "commit", "generatedAt", "components", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "frameworkId": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "components": { "type": "array" },
    "summary": {
      "type": "object",
      "required": ["componentCount", "complete", "partial", "empty", "failed"],
      "properties": {
        "componentCount": { "type": "integer", "minimum": 0 },
        "complete": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "empty": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
