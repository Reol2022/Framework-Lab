{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/baseline-run.schema.json",
  "title": "Framework Baseline Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "framework",
    "status",
    "startedAt",
    "finishedAt",
    "totalDurationMs",
    "environmentFile",
    "sourceFile",
    "reportFile",
    "steps",
    "firstBlockingStep",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "pattern": "^run-[0-9]{3,}$" },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["passed", "failed", "partial"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "totalDurationMs": { "type": "integer", "minimum": 0 },
    "environmentFile": { "type": "string", "const": "environment.json" },
    "sourceFile": { "type": "string", "const": "source.json" },
    "reportFile": { "type": "string", "const": "report.md" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "args",
          "cwd",
          "startedAt",
          "finishedAt",
          "durationMs",
          "exitCode",
          "status",
          "stdoutLog",
          "stderrLog",
          "allowFailure",
          "timeoutSeconds"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "exitCode": { "type": ["integer", "null"] },
          "status": { "enum": ["passed", "failed", "skipped", "timed_out"] },
          "stdoutLog": { "type": "string", "pattern": "^steps/.+\\.stdout\\.log$" },
          "stderrLog": { "type": "string", "pattern": "^steps/.+\\.stderr\\.log$" },
          "allowFailure": { "type": "boolean" },
          "timeoutSeconds": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "firstBlockingStep": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errorsFile": { "type": "string", "const": "errors.json" },
    "errorSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "errors", "warnings", "recognized", "unrecognized", "byTool", "byCategory"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "recognized": { "type": "integer", "minimum": 0 },
        "unrecognized": { "type": "integer", "minimum": 0 },
        "byTool": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byCategory": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "firstBlockingErrorId": { "type": ["string", "null"] }
  }
}
