{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/docs-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "entryPages"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "mode": { "enum": ["http", "browser", "file", "auto"] },
          "baseUrl": { "type": "string", "minLength": 1 },
          "basePath": { "type": "string", "minLength": 1 },
          "entryPages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "sourceType": { "enum": ["official-doc", "official-example", "test", "runtime-record"] }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "file" } } },
            "then": { "required": ["basePath"] }
          },
          {
            "if": { "properties": { "mode": { "enum": ["http", "auto"] } } },
            "then": { "required": ["baseUrl"] }
          }
        ]
      }
    }
  }
}
