{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracked Source Files Catalog",
  "type": "object",
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "basename", "extension", "category", "language", "packageId", "sizeBytes", "lineCount", "sha256", "isText", "encoding", "generated", "executable", "symlink", "symlinkTarget", "gitObjectId", "warnings"],
        "properties": {
          "id": { "type": "string", "pattern": "^file-[a-f0-9]{16}$" },
          "path": { "$ref": "#/$defs/path" },
          "category": { "enum": ["source", "documentation", "example", "test", "config", "manifest", "build", "style", "asset", "generated", "other"] },
          "packageId": { "type": ["string", "null"] },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "lineCount": { "type": ["integer", "null"], "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha" },
          "isText": { "type": "boolean" },
          "generated": { "type": "boolean" },
          "executable": { "type": "boolean" },
          "symlink": { "type": "boolean" },
          "symlinkTarget": { "type": ["string", "null"] },
          "gitObjectId": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
