{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "retrievalId", "generatorVersion", "taskProfile", "sourceCommit", "sourceDirty", "catalogSnapshotId", "catalogRootHash", "symbolSnapshotId", "symbolRootHash", "initialCandidates", "expandedCandidates", "selectedCandidates", "excludedCandidates", "scoreBreakdown", "graphPaths", "scopeDecisions", "confidenceAdjustments", "diagnosticImpacts", "snippetSelections", "budgetDecisions", "businessHash", "outputSha256"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatorVersion": { "const": "0.1.7" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceDirty": { "const": false },
    "catalogRootHash": { "$ref": "#/$defs/hash" },
    "symbolRootHash": { "$ref": "#/$defs/hash" },
    "businessHash": { "$ref": "#/$defs/hash" },
    "selectedCandidates": { "type": "array", "uniqueItems": true },
    "outputSha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
