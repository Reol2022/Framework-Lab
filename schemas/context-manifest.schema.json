{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "contextId", "knowledgeIndexSha256", "selectedCards", "excludedCards", "filteredClaims", "scopeResults", "budgetDecisions", "generatorVersion", "sourceRun", "sourceCommit", "outputSha256"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contextId": { "type": "string" },
    "knowledgeIndexSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selectedCards": { "type": "array", "items": { "type": "object" } },
    "excludedCards": { "type": "array", "items": { "type": "object" } },
    "filteredClaims": { "type": "array", "items": { "type": "object" } },
    "scopeResults": { "type": "array", "items": { "type": "object" } },
    "budgetDecisions": { "type": "array", "items": { "type": "string" } },
    "generatorVersion": { "type": "string" },
    "sourceRun": { "type": ["string", "null"] },
    "sourceCommit": { "type": ["string", "null"] },
    "retrievalId": { "type": ["string", "null"] },
    "retrievalBusinessHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "selectedFrameworkCandidates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "snippetSelections": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "frameworkKnowledgeEnabled": { "type": "boolean" },
    "explainSelection": { "type": "boolean" },
    "outputSha256": {
      "type": "object",
      "required": ["context.json", "context.md"],
      "properties": {
        "context.json": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "context.md": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
