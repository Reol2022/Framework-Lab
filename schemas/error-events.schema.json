{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/error-events.schema.json",
  "title": "Framework Lab Structured Error Events",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "frameworkId", "generatedAt", "summary", "firstBlockingErrorId", "events"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "pattern": "^(?:run-[0-9]{3,}|task-[a-z0-9-]+)$" },
    "frameworkId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": { "$ref": "#/$defs/summary" },
    "firstBlockingErrorId": { "type": ["string", "null"] },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "errors", "warnings", "recognized", "unrecognized", "byTool", "byCategory"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "recognized": { "type": "integer", "minimum": 0 },
        "unrecognized": { "type": "integer", "minimum": 0 },
        "byTool": { "$ref": "#/$defs/countMap" },
        "byCategory": { "$ref": "#/$defs/countMap" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "parser", "parserVersion", "tool", "category", "severity", "stepId",
        "message", "file", "line", "column", "rule", "code", "plugin", "rawExcerpt",
        "sourceLog", "fingerprint", "blocking", "confidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^error-[a-f0-9]{12}(?:-[0-9]+)?$" },
        "parser": { "type": "string", "minLength": 1 },
        "parserVersion": { "type": "string", "minLength": 1 },
        "tool": { "enum": ["eslint", "sass", "vite", "typescript", "node", "pnpm", "generic"] },
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning"] },
        "stepId": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "rule": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] },
        "plugin": { "type": ["string", "null"] },
        "rawExcerpt": { "type": "string", "maxLength": 1200 },
        "sourceLog": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "blocking": { "type": "boolean" },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    }
  }
}
