{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/parsed-docs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collectionId", "frameworkId", "frameworkCommit", "pages", "rootHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "collectionId": { "type": "string", "minLength": 1 },
    "frameworkId": { "type": "string", "minLength": 1 },
    "frameworkCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "id", "sourceId", "url", "contentHash", "quality", "components"]
      }
    },
    "rootHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
