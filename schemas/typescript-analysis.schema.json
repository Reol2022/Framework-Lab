{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["schemaVersion","frameworkId","symbolSnapshotId","catalogSnapshotId","catalogRootHash","sourceCommit","sourceClean","scannerVersion","typescriptVersion","syntaxOnly","semanticAvailable","generatedAt","rootHash","counts","files","warnings","blockingDiagnostics"],"properties":{"schemaVersion":{"const":"1.0.0"},"frameworkId":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"sourceCommit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"catalogRootHash":{"$ref":"#/$defs/hash"},"rootHash":{"$ref":"#/$defs/hash"},"sourceClean":{"const":true},"scannerVersion":{"const":"0.1.6"},"generatedAt":{"type":"string","format":"date-time"},"files":{"type":"array","items":{"$ref":"#/$defs/path"}}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"path":{"type":"string","pattern":"^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$"}}}
