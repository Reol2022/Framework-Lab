{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current Catalog Pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameworkId", "snapshotId", "commit", "rootHash", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "frameworkId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "snapshotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "rootHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
