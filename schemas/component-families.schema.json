{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "frameworkId", "sourceCommit", "catalogRootHash", "symbolRootHash", "generatedAt", "candidates", "businessHash"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "frameworkId": { "type": "string" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "catalogRootHash": { "type": "string", "pattern": "^sha256:" },
    "symbolRootHash": { "type": "string", "pattern": "^sha256:" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "proposedName", "structuralSignal", "componentIds", "componentNames", "representativeComponents", "sharedBaseTypes", "sharedInterfaces", "sharedEvents", "sharedMethods", "sharedProperties", "sharedStylePatterns", "publicPackages", "evidence", "confidence", "detectionReasons", "reviewStatus", "limitations"],
        "properties": {
          "id": { "type": "string" },
          "proposedName": { "type": "string" },
          "structuralSignal": { "type": "string" },
          "componentIds": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "componentNames": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "representativeComponents": { "type": "array", "items": { "type": "string" } },
          "sharedBaseTypes": { "type": "array", "items": { "type": "string" } },
          "sharedInterfaces": { "type": "array", "items": { "type": "string" } },
          "sharedEvents": { "type": "array", "items": { "type": "string" } },
          "sharedMethods": { "type": "array", "items": { "type": "string" } },
          "sharedProperties": { "type": "array", "items": { "type": "string" } },
          "sharedStylePatterns": { "type": "array", "items": { "type": "string" } },
          "publicPackages": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "object" } },
          "confidence": { "const": "structural-candidate" },
          "detectionReasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "reviewStatus": { "enum": ["pending", "approved", "rejected"] },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "businessHash": { "type": "string", "pattern": "^sha256:" }
  }
}
