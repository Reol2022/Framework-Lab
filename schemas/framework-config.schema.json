{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/framework-config.schema.json",
  "title": "Framework Baseline Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework", "package_manager", "stop_on_failure", "baseline_steps"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source_dir"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "source_dir": { "type": "string", "minLength": 1 }
      }
    },
    "package_manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 }
      }
    },
    "stop_on_failure": { "type": "boolean" },
    "baseline_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "args", "timeout_seconds", "allow_failure"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "allow_failure": { "type": "boolean" }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mode", "entryPages"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "mode": { "enum": ["http", "browser", "file", "auto"] },
              "baseUrl": { "type": "string", "minLength": 1 },
              "basePath": { "type": "string", "minLength": 1 },
              "entryPages": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "sourceType": {
                "enum": ["official-doc", "official-example", "test", "runtime-record"]
              }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "const": "file" } } },
                "then": { "required": ["basePath"] }
              },
              {
                "if": { "properties": { "mode": { "enum": ["http", "auto"] } } },
                "then": { "required": ["baseUrl"] }
              }
            ]
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "componentDetection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceGlobs", "baseTypes", "publicPackages", "stylePatterns", "examplePatterns"],
              "properties": {
                "sourceGlobs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "baseTypes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "publicPackages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "stylePatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "examplePatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "lifecycleMethods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "registrationFunctions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identifierPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "aliases": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
