{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/task-handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "contextHash", "worktreeFingerprint", "instructionHash", "generatedAt", "status", "externalAgent", "externalAgentVersion", "model", "reasoningLevel", "sessionUsage", "startedAt", "finishedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string" },
    "contextHash": { "$ref": "#/$defs/hash" },
    "worktreeFingerprint": { "$ref": "#/$defs/hash" },
    "instructionHash": { "$ref": "#/$defs/hash" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "in_progress", "completed"] },
    "externalAgent": { "type": ["string", "null"] },
    "externalAgentVersion": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "reasoningLevel": { "type": ["string", "null"] },
    "sessionUsage": { "type": ["object", "null"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
