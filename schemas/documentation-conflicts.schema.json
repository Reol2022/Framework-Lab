{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework-lab.example/schemas/documentation-conflicts.schema.json",
  "type": "object",
  "required": ["schemaVersion", "frameworkId", "commit", "generatedAt", "conflicts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "frameworkId": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component", "itemKind", "itemName", "sourceA", "sourceB", "evidence", "severity", "suggestedAction", "conflictType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 },
          "itemKind": { "type": "string", "minLength": 1 },
          "itemName": { "type": "string", "minLength": 1 },
          "sourceA": { "type": "string", "minLength": 1 },
          "sourceB": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1 },
          "severity": { "enum": ["error", "warning"] },
          "suggestedAction": { "type": "string", "minLength": 1 },
          "conflictType": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
