# Operating systems
.DS_Store
Thumbs.db
Desktop.ini

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Node.js
node_modules/
dist/
build/
.nuxt/
.next/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Test and browser artifacts
test-results/
playwright-report/
blob-report/
screenshots/

# Environment files (allow a public template)
.env
.env.*
!.env.example

# Secrets and local configuration
*.pem
*.key
*.p12
secrets/
local-config/

# Private data
private/
private-data/
production-data/

# Local framework source repositories
.framework-sources/

# Repository-local framework toolchains
.framework-tools/

# Local baseline evidence may contain large logs and machine-specific paths
frameworks/*/runs/*
!frameworks/*/runs/README.md

# Raw run evidence may include machine paths, process output and browser sessions
frameworks/*/reports/raw/**

# Local generated Agent contexts
frameworks/*/contexts/*
!frameworks/*/contexts/README.md

# Local source catalogs may expose repository structure and binary metadata
frameworks/*/catalog/current.json
frameworks/*/catalog/snapshots/*
frameworks/*/catalog/diffs/*
!frameworks/*/catalog/README.md

# Local symbol snapshots derive from local source catalogs
frameworks/*/symbols/current.json
frameworks/*/symbols/snapshots/*
frameworks/*/symbols/diffs/*
!frameworks/*/symbols/README.md

# Local task retrievals may contain source excerpts and framework structure
frameworks/*/retrievals/*
!frameworks/*/retrievals/README.md

# Controlled task bundles may contain local Context, raw patches, logs and worktree evidence
frameworks/*/tasks/task-*/

# Learning bundles and drafts contain bounded source excerpts and external Agent output
frameworks/*/learning/bundles/**
frameworks/*/learning/drafts/**
frameworks/*/learning/refresh/*/bundles/**

# External Agent drafts and raw session transcripts are private evaluation evidence
frameworks/*/learning/interoperability/**
frameworks/*/evaluations/*/agent-demos/**/events.jsonl
frameworks/*/evaluations/*/agent-demos/**/final.md

# Source patches are kept locally until their publication policy is decided
frameworks/*/patches/*.patch

# Resume-specific notes may contain personal or unrelated private-project material
docs/learning/14-简历高频追问与答题卡.md
docs/learning/changelog/2026-07-24.md
